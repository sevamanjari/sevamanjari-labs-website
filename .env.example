# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sevamanjari_labs?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your-secure-random-jwt-secret-string

# Outgoing SMTP Configuration
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@sevamanjarilabs.in
SMTP_PASS=your-smtp-password

# Optional Initial Official Bootstrap
ADMIN_EMAIL=info@sevamanjarilabs.in
ADMIN_PASSWORD=your-secure-admin-password
